{"data":{"list":[{"author":"agent","facet":"html","label":"files boot: minimalist browser markup","new":"<div class=\"filesapp\">\n  <header class=\"fb-head\">\n    <nav class=\"fb-crumbs\" aria-label=\"Path\"></nav>\n    <div class=\"fb-actions\">\n      <label class=\"fb-upload\" title=\"Upload a file into this folder\">\n        <input type=\"file\" class=\"fb-file\" multiple>\n        <span>Upload</span>\n      </label>\n    </div>\n  </header>\n\n  <div class=\"fb-status\" role=\"status\" aria-live=\"polite\"></div>\n\n  <main class=\"fb-list\" aria-label=\"Directory listing\">\n    <div class=\"fb-empty\">Loading…</div>\n  </main>\n\n  <footer class=\"fb-foot\">\n    <span class=\"fb-dav\">Connect via WebDAV: <code>/files/dav</code></span>\n  </footer>\n</div>\n","old":"","patch_id":"p1","time":1793906084766},{"author":"agent","facet":"css","label":"files boot: restrained stylesheet","new":"/* files — minimalist browser. One accent, generous whitespace, no chrome\n   beyond the breadcrumb and the listing. */\n.filesapp {\n  --accent: #2f6feb;\n  --ink: #1c1f24;\n  --muted: #8a9099;\n  --rule: #eceef1;\n  --bg: #ffffff;\n\n  box-sizing: border-box;\n  max-width: 860px;\n  margin: 0 auto;\n  padding: 40px 28px 56px;\n  background: var(--bg);\n  color: var(--ink);\n  font: 15px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n.filesapp *, .filesapp *::before, .filesapp *::after { box-sizing: inherit; }\n\n/* ---- breadcrumb bar ---- */\n.fb-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 16px;\n  padding-bottom: 14px;\n  border-bottom: 1px solid var(--rule);\n}\n.fb-crumbs {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 2px;\n  min-width: 0;\n  font-size: 15px;\n}\n.fb-crumbs .fb-crumb {\n  color: var(--accent);\n  text-decoration: none;\n  padding: 2px 4px;\n  border-radius: 4px;\n  cursor: pointer;\n  white-space: nowrap;\n}\n.fb-crumbs .fb-crumb:hover { background: rgba(47, 111, 235, 0.08); }\n.fb-crumbs .fb-crumb.is-here { color: var(--ink); font-weight: 600; cursor: default; }\n.fb-crumbs .fb-crumb.is-here:hover { background: none; }\n.fb-crumbs .fb-sep { color: var(--muted); padding: 0 1px; user-select: none; }\n\n/* ---- upload affordance ---- */\n.fb-actions { flex: none; }\n.fb-upload {\n  display: inline-block;\n  padding: 6px 14px;\n  border: 1px solid var(--rule);\n  border-radius: 6px;\n  color: var(--accent);\n  font-size: 13px;\n  cursor: pointer;\n  transition: border-color .15s, background .15s;\n}\n.fb-upload:hover { border-color: var(--accent); background: rgba(47, 111, 235, 0.06); }\n.fb-upload input[type=\"file\"] { display: none; }\n\n/* ---- status line ---- */\n.fb-status {\n  min-height: 20px;\n  padding: 10px 0 0;\n  font-size: 13px;\n  color: var(--muted);\n}\n.fb-status.is-err { color: #c0392b; }\n\n/* ---- listing ---- */\n.fb-list { padding-top: 8px; }\n.fb-row {\n  display: grid;\n  grid-template-columns: 22px 1fr 96px 150px;\n  align-items: center;\n  gap: 12px;\n  padding: 11px 6px;\n  border-bottom: 1px solid var(--rule);\n  text-decoration: none;\n  color: inherit;\n}\n.fb-row:last-child { border-bottom: none; }\n.fb-row:hover { background: rgba(47, 111, 235, 0.04); }\n.fb-row .fb-icon {\n  width: 18px; height: 18px;\n  display: inline-flex; align-items: center; justify-content: center;\n  color: var(--muted);\n  font-size: 15px;\n  line-height: 1;\n}\n.fb-row.is-dir .fb-icon { color: var(--accent); }\n.fb-row .fb-name {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.fb-row.is-dir .fb-name { color: var(--accent); cursor: pointer; }\n.fb-row .fb-size,\n.fb-row .fb-mtime {\n  font-size: 12.5px;\n  color: var(--muted);\n  text-align: right;\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n}\n.fb-row .fb-dl {\n  color: var(--accent);\n  text-decoration: none;\n  font-size: 12.5px;\n  text-align: right;\n  white-space: nowrap;\n}\n.fb-row .fb-dl:hover { text-decoration: underline; }\n\n.fb-empty {\n  padding: 28px 6px;\n  color: var(--muted);\n  font-size: 14px;\n}\n\n/* ---- footer: the quiet WebDAV line ---- */\n.fb-foot {\n  margin-top: 28px;\n  padding-top: 14px;\n  border-top: 1px solid var(--rule);\n  font-size: 12.5px;\n  color: var(--muted);\n}\n.fb-foot code {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 12px;\n  color: var(--ink);\n}\n\n@media (max-width: 620px) {\n  .filesapp { padding: 24px 16px 40px; }\n  .fb-row { grid-template-columns: 22px 1fr 84px; }\n  .fb-row .fb-mtime { display: none; }\n}\n","old":"","patch_id":"p2","time":1793906127980},{"author":"executive","facet":"js","label":"files boot: minimalist browser js (breadcrumb, listing, download, upload)","new":"var me = this;\nvar ME = $('#' + me.UUID)[0];\n\nme.ready = function(){\n  var state = { path: '' };\n\n  var $crumbs = $(ME).find('.fb-crumbs');\n  var $list   = $(ME).find('.fb-list');\n  var $status = $(ME).find('.fb-status');\n  var $upload = $(ME).find('.fb-file');\n\n  function say(msg, isErr){\n    $status.text(msg || '').toggleClass('is-err', !!isErr);\n  }\n\n  function fmtSize(n){\n    if (n === null || n === undefined) return '';\n    if (n < 1024) return n + ' B';\n    var u = ['KB','MB','GB','TB'], i = -1, v = n;\n    do { v = v / 1024; i++; } while (v >= 1024 && i < u.length - 1);\n    return (v < 10 ? v.toFixed(1) : Math.round(v)) + ' ' + u[i];\n  }\n\n  function fmtTime(ms){\n    if (!ms) return '';\n    var d = new Date(ms);\n    if (isNaN(d.getTime())) return '';\n    var p = function(x){ return (x < 10 ? '0' : '') + x; };\n    return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) +\n           ' ' + p(d.getHours()) + ':' + p(d.getMinutes());\n  }\n\n  function joinPath(dir, name){\n    if (!dir) return name;\n    return dir.replace(/\\/+$/, '') + '/' + name;\n  }\n\n  function parentOf(p){\n    var s = String(p || '').replace(/\\/+$/, '');\n    var i = s.lastIndexOf('/');\n    return i < 0 ? '' : s.slice(0, i);\n  }\n\n  function renderCrumbs(p){\n    $crumbs.empty();\n    var parts = String(p || '').split('/').filter(function(s){ return s.length; });\n    var acc = '';\n    var add = function(label, target, here){\n      if ($crumbs.children().length) $crumbs.append('<span class=\"fb-sep\">/</span>');\n      var $a = $('<a class=\"fb-crumb\"></a>').text(label);\n      if (here) $a.addClass('is-here');\n      else $a.on('click', function(){ go(target); });\n      $crumbs.append($a);\n    };\n    add('root', '', parts.length === 0);\n    parts.forEach(function(seg, idx){\n      acc = acc ? acc + '/' + seg : seg;\n      add(seg, acc, idx === parts.length - 1);\n    });\n  }\n\n  function renderEntries(entries){\n    $list.empty();\n    if (!entries || !entries.length){\n      $list.append($('<div class=\"fb-empty\"></div>').text('This folder is empty.'));\n      return;\n    }\n    entries.forEach(function(e){\n      var isDir = !!e.isdir;\n      var $row = $('<div class=\"fb-row\"></div>').toggleClass('is-dir', isDir);\n      $row.append($('<span class=\"fb-icon\"></span>').text(isDir ? '\\u25B8' : '\\u00B7'));\n      $row.append($('<span class=\"fb-name\"></span>').text(e.name));\n      $row.append($('<span class=\"fb-size\"></span>').text(isDir ? '' : fmtSize(e.size)));\n      $row.append($('<span class=\"fb-mtime\"></span>').text(fmtTime(e.mtime)));\n      if (isDir){\n        $row.on('click', function(){ go(e.path); });\n      } else {\n        var $dl = $('<a class=\"fb-dl\">download</a>')\n          .attr('href', '/files/get_file?path=' + encodeURIComponent(e.path))\n          .attr('download', e.name);\n        $row.append($dl);\n      }\n      $list.append($row);\n    });\n  }\n\n  function go(p){\n    state.path = p || '';\n    renderCrumbs(state.path);\n    say('Loading\\u2026');\n    send_list_dir(state.path, function(result){\n      if (!result || result.status !== 'ok'){\n        say((result && result.msg) || 'Could not list this folder.', true);\n        $list.empty().append($('<div class=\"fb-empty\"></div>').text('Nothing to show.'));\n        return;\n      }\n      var data = result.data || {};\n      var entries = data.entries || [];\n      state.path = data.path || state.path;\n      renderCrumbs(state.path);\n      renderEntries(entries);\n      say(entries.length + (entries.length === 1 ? ' item' : ' items'));\n    });\n  }\n\n  $upload.on('change', function(){\n    var files = Array.prototype.slice.call(this.files || []);\n    if (!files.length) return;\n    var pending = files.length;\n    var failed = 0;\n    say('Uploading ' + pending + '\\u2026');\n    files.forEach(function(f){\n      var reader = new FileReader();\n      reader.onload = function(){\n        var bytes = new Uint8Array(reader.result);\n        send_put_file(joinPath(state.path, f.name), bytes, function(res){\n          if (!res || res.status !== 'ok') failed++;\n          pending--;\n          if (pending === 0){\n            if (failed) say(failed + ' upload(s) failed.', true);\n            else say('Uploaded ' + files.length + (files.length === 1 ? ' file' : ' files'));\n            $upload.val('');\n            go(state.path);\n          }\n        });\n      };\n      reader.onerror = function(){\n        failed++; pending--;\n        if (pending === 0){ say('Upload failed.', true); $upload.val(''); go(state.path); }\n      };\n      reader.readAsArrayBuffer(f);\n    });\n  });\n\n  go('');\n};\n","old":"","patch_id":"p3","time":1793908106609},{"author":"executive","facet":"js","label":"normalize ./ prefix out of paths so breadcrumbs and joins are clean","new":"  function joinPath(dir, name){\n    if (!dir) return name;\n    return dir.replace(/\\/+$/, '') + '/' + name;\n  }\n\n  // The backend answers paths like \"./agent\"; strip the leading \"./\" so the\n  // breadcrumb shows \"root / agent\" and not \"root / . / agent\".\n  function cleanPath(p){\n    var s = String(p || '').replace(/\\\\/g, '/');\n    while (s.indexOf('./') === 0) s = s.slice(2);\n    return s.replace(/^\\/+/, '').replace(/\\/+$/, '');\n  }\n","old":"  function joinPath(dir, name){\n    if (!dir) return name;\n    return dir.replace(/\\/+$/, '') + '/' + name;\n  }\n\n  function parentOf(p){\n    var s = String(p || '').replace(/\\/+$/, '');\n    var i = s.lastIndexOf('/');\n    return i < 0 ? '' : s.slice(0, i);\n  }\n","patch_id":"p4","time":1793908277606},{"author":"executive","facet":"js","label":"use cleanPath in renderCrumbs and go()","new":"  function renderCrumbs(p){\n    $crumbs.empty();\n    var parts = cleanPath(p).split('/').filter(function(s){ return s.length; });\n","old":"  function renderCrumbs(p){\n    $crumbs.empty();\n    var parts = String(p || '').split('/').filter(function(s){ return s.length; });\n","patch_id":"p5","time":1793908284367},{"author":"executive","facet":"js","label":"go() stores the cleaned path so joins and crumbs agree","new":"  function go(p){\n    state.path = cleanPath(p);\n    renderCrumbs(state.path);\n    say('Loading\\u2026');\n    send_list_dir(state.path, function(result){\n      if (!result || result.status !== 'ok'){\n        say((result && result.msg) || 'Could not list this folder.', true);\n        $list.empty().append($('<div class=\"fb-empty\"></div>').text('Nothing to show.'));\n        return;\n      }\n      var data = result.data || {};\n      var entries = data.entries || [];\n      state.path = cleanPath(data.path || state.path);\n      renderCrumbs(state.path);\n      renderEntries(entries);\n      say(entries.length + (entries.length === 1 ? ' item' : ' items'));\n    });\n  }\n","old":"  function go(p){\n    state.path = p || '';\n    renderCrumbs(state.path);\n    say('Loading\\u2026');\n    send_list_dir(state.path, function(result){\n      if (!result || result.status !== 'ok'){\n        say((result && result.msg) || 'Could not list this folder.', true);\n        $list.empty().append($('<div class=\"fb-empty\"></div>').text('Nothing to show.'));\n        return;\n      }\n      var data = result.data || {};\n      var entries = data.entries || [];\n      state.path = data.path || state.path;\n      renderCrumbs(state.path);\n      renderEntries(entries);\n      say(entries.length + (entries.length === 1 ? ' item' : ' items'));\n    });\n  }\n","patch_id":"p6","time":1793908296152},{"author":"executive","facet":"js","label":"cleanPath: a bare '.' means the root","new":"  function cleanPath(p){\n    var s = String(p || '').replace(/\\\\/g, '/');\n    while (s.indexOf('./') === 0) s = s.slice(2);\n    s = s.replace(/^\\/+/, '').replace(/\\/+$/, '');\n    return s === '.' ? '' : s;\n  }\n","old":"  function cleanPath(p){\n    var s = String(p || '').replace(/\\\\/g, '/');\n    while (s.indexOf('./') === 0) s = s.slice(2);\n    return s.replace(/^\\/+/, '').replace(/\\/+$/, '');\n  }\n","patch_id":"p7","time":1793908344500},{"author":"agent","facet":"js","label":"Upload files as raw WebDAV bodies","new":"  function go(p, completion){\n    state.path = cleanPath(p);\n    renderCrumbs(state.path);\n    say('Loading\\u2026');\n    send_list_dir(state.path, function(result){\n      if (!result || result.status !== 'ok'){\n        say((result && result.msg) || 'Could not list this folder.', true);\n        $list.empty().append($('<div class=\"fb-empty\"></div>').text('Nothing to show.'));\n        return;\n      }\n      var data = result.data || {};\n      var entries = data.entries || [];\n      state.path = cleanPath(data.path || state.path);\n      renderCrumbs(state.path);\n      renderEntries(entries);\n      if (completion && completion.message) say(completion.message, completion.isErr);\n      else say(entries.length + (entries.length === 1 ? ' item' : ' items'));\n    });\n  }\n\n  async function uploadFile(file, directory){\n    var relative = joinPath(directory, file.name);\n    var url = '/files/dav/' + relative.split('/').map(encodeURIComponent).join('/');\n    var response = await fetch(url, {\n      method: 'PUT',\n      body: file,\n      credentials: 'same-origin',\n      headers: { 'Content-Type': file.type || 'application/octet-stream' }\n    });\n    if (!response.ok){\n      var message = await response.text();\n      throw new Error(message || ('Upload failed: HTTP ' + response.status));\n    }\n  }","old":"  function go(p){\n    state.path = cleanPath(p);\n    renderCrumbs(state.path);\n    say('Loading\\u2026');\n    send_list_dir(state.path, function(result){\n      if (!result || result.status !== 'ok'){\n        say((result && result.msg) || 'Could not list this folder.', true);\n        $list.empty().append($('<div class=\"fb-empty\"></div>').text('Nothing to show.'));\n        return;\n      }\n      var data = result.data || {};\n      var entries = data.entries || [];\n      state.path = cleanPath(data.path || state.path);\n      renderCrumbs(state.path);\n      renderEntries(entries);\n      say(entries.length + (entries.length === 1 ? ' item' : ' items'));\n    });\n  }","patch_id":"p8","time":1793981280174},{"author":"agent","facet":"js","label":"Preserve WebDAV upload results and errors","new":"  $upload.on('change', async function(){\n    var files = Array.prototype.slice.call(this.files || []);\n    if (!files.length) return;\n    var directory = state.path;\n    var errors = [];\n    var uploaded = 0;\n    $upload.prop('disabled', true);\n    say('Uploading ' + files.length + '\\u2026');\n    try {\n      for (var file of files){\n        try {\n          await uploadFile(file, directory);\n          uploaded++;\n        }\n        catch (err) {\n          errors.push(file.name + ': ' + err.message);\n        }\n      }\n    }\n    finally {\n      $upload.prop('disabled', false).val('');\n    }\n    var message;\n    if (errors.length){\n      message = uploaded + ' of ' + files.length + ' uploaded. ' + errors.join(' | ');\n    }\n    else {\n      message = 'Uploaded ' + uploaded + (uploaded === 1 ? ' file' : ' files');\n    }\n    go(directory, { message: message, isErr: errors.length > 0 });\n  });","old":"  $upload.on('change', function(){\n    var files = Array.prototype.slice.call(this.files || []);\n    if (!files.length) return;\n    var pending = files.length;\n    var failed = 0;\n    say('Uploading ' + pending + '\\u2026');\n    files.forEach(function(f){\n      var reader = new FileReader();\n      reader.onload = function(){\n        var bytes = new Uint8Array(reader.result);\n        send_put_file(joinPath(state.path, f.name), bytes, function(res){\n          if (!res || res.status !== 'ok') failed++;\n          pending--;\n          if (pending === 0){\n            if (failed) say(failed + ' upload(s) failed.', true);\n            else say('Uploaded ' + files.length + (files.length === 1 ? ' file' : ' files'));\n            $upload.val('');\n            go(state.path);\n          }\n        });\n      };\n      reader.onerror = function(){\n        failed++; pending--;\n        if (pending === 0){ say('Upload failed.', true); $upload.val(''); go(state.path); }\n      };\n      reader.readAsArrayBuffer(f);\n    });\n  });","patch_id":"p9","time":1793981297656}]},"id":"lgkjpt1a1acf6a36dh44_patches","readers":[],"time":1793981297656,"username":"system","writers":[]}